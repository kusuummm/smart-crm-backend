# =================================================================
# SMART CRM - PRODUCTION ENVIRONMENT CONFIGURATION
# Fill in your real API credentials when ready to go live.
# =================================================================

# Server Port and Environment
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart-crm?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend URLs for CORS (comma separated)
CLIENT_URL=http://localhost:3000,http://localhost:5173

# =================================================================
# 1. REAL TELEPHONY & CLOUD CALLING PROVIDERS
# =================================================================
# Option A: Twilio Voice & Recording
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_TWIML_APP_SID=your_twiml_app_sid

# Option B: Exotel (India Telephony)
EXOTEL_ACCOUNT_SID=your_exotel_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_CALLER_ID=your_exotel_virtual_number

# Telephony Provider Selection ('twilio', 'exotel', or 'browser-direct')
TELEPHONY_PROVIDER=browser-direct
VIRTUAL_NUMBERS=+91 99999 88888,+91 98888 77777

# =================================================================
# 2. META WHATSAPP BUSINESS CLOUD API
# =================================================================
WHATSAPP_TOKEN=your_meta_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_secret_token

# =================================================================
# 3. PAYMENT GATEWAY (UPI & WALLET RECHARGES)
# =================================================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# =================================================================
# 4. PROFESSIONAL EMAIL (NODEMAILER / SMTP)
# =================================================================
EMAIL_HOST=smtp.yourmailserver.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_email_password
EMAIL_FROM="SmartCRM <your_email@domain.com>"

# =================================================================
# 5. CLOUD STORAGE FOR CALL RECORDINGS & AUDIO (AWS S3 / CLOUDINARY)
# =================================================================
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=smart-crm-call-recordings

# =================================================================
# 6. AI AUDIO, TRANSCRIPTION & SENTIMENT ANALYSIS (OPENAI / GEMINI)
# =================================================================
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
